<%- include('partials/head', { title, theme }) %>

<main class="admin-page omega-page">
  <header class="page-header glass-card omega-header">
    <div class="admin-header-left">
      <img src="<%= fixedLogoUrl %>" alt="Omega Distribuidora" class="omega-logo" onerror="this.onerror=null;this.src='/public/assets/omega-logo.svg';" />
      <div>
        <h1>Gerenciar Sistemas</h1>
        <p>Criar e editar sistemas no mesmo painel, com imagem de card local.</p>
      </div>
    </div>

    <div class="page-actions">
      <details class="admin-nav-dropdown">
        <summary class="btn btn-secondary">Navegacao</summary>
        <div class="admin-nav-menu glass-card">
          <a href="/admin">Menu Admin</a>
          <a href="/admin/users">Usuarios</a>
          <a href="/admin/systems">Sistemas</a>
          <a href="/admin/notices">Comunicados</a>
          <a href="/admin/mappings">Mapeamentos</a>
          <a href="/admin/history">Historico</a>
          <a href="/dashboard">Painel Principal</a>
        </div>
      </details>
    </div>
  </header>

  <%- include('partials/flash', { flash }) %>

  <section class="split-grid admin-management-grid">
    <article class="glass-card admin-section">
      <div class="admin-section-head">
        <div>
          <h2 class="section-title">Sistemas</h2>
          <p class="muted">Cadastre e edite modulos em popup, com imagem de card e configuracao SSO no mesmo fluxo.</p>
        </div>
        <button type="button" class="btn btn-primary" data-open-modal="system-create-modal">Novo Sistema</button>
      </div>

      <div class="admin-callout">
        <strong>Gestao mais objetiva</strong>
        <p class="muted small">A listagem fica compacta e a configuracao completa abre em modal quando voce realmente precisa editar.</p>
      </div>
    </article>

    <article class="glass-card admin-section">
      <h2 class="section-title">Sistemas Cadastrados</h2>

      <div class="compact-list">
        <% systems.forEach((system) => { %>
          <% const allowedUsers = users
            .filter((u) => {
              const ids = (u.system_ids || '').split(',').map((id) => Number(id)).filter((id) => Number.isInteger(id) && id > 0);
              return ids.includes(system.id);
            })
            .map((u) => u.username); %>
          <% const compactUrl = String(system.url || '').replace(/^https?:\/\//i, ''); %>
          <% const compactUrlLabel = compactUrl.length > 42 ? `${compactUrl.slice(0, 39)}...` : compactUrl; %>
          <div class="compact-row">
            <div class="compact-main">
              <strong><%= system.name %></strong>
              <span class="muted small compact-url"><%= compactUrlLabel %></span>
              <span class="muted small">SSO: <%= system.sso_enabled ? `ativo (${system.sso_key || 'sem chave'})` : 'desligado' %></span>
              <span class="muted small">Imagem do card: <%= system.preview_image_url || 'sem imagem' %></span>
              <span class="muted small">Usuarios: <%= allowedUsers.join(', ') || 'somente admins' %></span>
            </div>
            <button
              type="button"
              class="icon-edit-btn"
              data-system-edit
              data-system-id="<%= system.id %>"
              data-name="<%= system.name %>"
              data-url="<%= system.url %>"
              data-description="<%= system.description || '' %>"
              data-sso-enabled="<%= system.sso_enabled ? '1' : '0' %>"
              data-sso-key="<%= system.sso_key || '' %>"
              data-preview-image-url="<%= system.preview_image_url || '' %>"
              title="Editar sistema"
            >
              &#9998;
            </button>
          </div>
        <% }) %>
      </div>

      <details class="image-library-toggle">
        <summary class="btn btn-ghost">Mostrar todas as imagens</summary>
        <div class="image-library-body">
          <p class="muted small">Pasta de destino: <code><%= imagesDir %></code></p>
          <div class="assets-grid">
            <% (uploadedImages || []).forEach((asset) => { %>
              <article class="asset-card compact-asset">
                <img src="<%= asset.url %>" alt="<%= asset.name %>" loading="lazy" />
                <div class="asset-meta">
                  <strong><%= asset.name %></strong>
                  <input type="text" readonly value="<%= asset.url %>" onclick="this.select()" />
                </div>
              </article>
            <% }) %>
          </div>
        </div>
      </details>
    </article>
  </section>

  <div class="admin-modal hidden" data-modal="system-create-modal" aria-hidden="true">
    <div class="admin-modal-backdrop" data-close-modal></div>
    <div class="admin-modal-dialog admin-modal-dialog-wide glass-card" role="dialog" aria-modal="true" aria-labelledby="system-create-modal-title">
      <div class="admin-modal-header">
        <div>
          <h3 id="system-create-modal-title">Novo Sistema</h3>
          <p class="muted small">Cadastre URL, imagem do card, usuarios iniciais e configuracao SSO.</p>
        </div>
        <button type="button" class="admin-modal-close" aria-label="Fechar popup" data-close-modal>&times;</button>
      </div>

      <form method="post" action="/admin/systems" enctype="multipart/form-data" class="form-stack compact admin-modal-form" data-reset-on-open>
        <label>
          Nome do sistema
          <input type="text" name="name" required />
        </label>

        <label>
          Link (URL)
          <input type="url" name="url" placeholder="https://..." required />
        </label>

        <label>
          Descricao
          <input type="text" name="description" />
        </label>

        <label class="check-row">
          <input type="checkbox" name="sso_enabled" />
          <span>Habilitar login delegado via Ecossistema</span>
        </label>

        <label>
          Chave SSO
          <input type="text" name="sso_key" placeholder="controle_ferias" />
        </label>

        <label>
          Imagem do card (16:9)
          <select name="preview_image_url" class="omega-select">
            <option value="">Sem imagem</option>
            <% (uploadedImages || []).forEach((asset) => { %>
              <option value="<%= asset.url %>"><%= asset.name %></option>
            <% }) %>
          </select>
        </label>

        <label>
          Ou envie uma nova imagem do card
          <input type="file" name="card_image_file" accept=".png,.jpg,.jpeg,.webp,.gif,.svg" />
        </label>
        <p class="muted small">Use uma imagem horizontal em proporcao 16:9. Se enviar um arquivo novo, ele substitui a selecao acima.</p>

        <fieldset>
          <legend>Usuarios com acesso inicial</legend>
          <div class="check-grid">
            <% usersBasic.forEach((user) => { %>
              <% if (!user.is_admin) { %>
                <label class="check-row">
                  <input type="checkbox" name="user_ids" value="<%= user.id %>" />
                  <span><%= user.username %></span>
                </label>
              <% } %>
            <% }) %>
          </div>
        </fieldset>

        <div class="form-actions-inline admin-modal-actions">
          <button type="button" class="btn btn-ghost" data-close-modal>Cancelar</button>
          <button type="submit" class="btn btn-primary">Adicionar Sistema</button>
        </div>
      </form>
    </div>
  </div>

  <div class="admin-modal hidden" data-modal="system-edit-modal" aria-hidden="true">
    <div class="admin-modal-backdrop" data-close-modal></div>
    <div class="admin-modal-dialog admin-modal-dialog-wide glass-card" role="dialog" aria-modal="true" aria-labelledby="system-edit-modal-title">
      <div class="admin-modal-header">
        <div>
          <h3 id="system-edit-modal-title" data-system-edit-title>Editar Sistema</h3>
          <p class="muted small">Atualize dados do modulo, imagem do card e configuracao de handoff.</p>
        </div>
        <button type="button" class="admin-modal-close" aria-label="Fechar popup" data-close-modal>&times;</button>
      </div>

      <form method="post" action="/admin/systems/0" enctype="multipart/form-data" class="form-stack compact admin-modal-form" data-system-edit-form>
        <label>
          Nome
          <input type="text" name="name" data-system-field="name" required />
        </label>

        <label>
          Link
          <input type="url" name="url" data-system-field="url" required />
        </label>

        <label>
          Descricao
          <input type="text" name="description" data-system-field="description" />
        </label>

        <label class="check-row">
          <input type="checkbox" name="sso_enabled" data-system-field="sso_enabled" />
          <span>Habilitar login delegado via Ecossistema</span>
        </label>

        <label>
          Chave SSO
          <input type="text" name="sso_key" data-system-field="sso_key" placeholder="controle_ferias" />
        </label>

        <label>
          Imagem do card (16:9)
          <select name="preview_image_url" class="omega-select" data-system-field="preview_image_url">
            <option value="">Sem imagem</option>
            <% (uploadedImages || []).forEach((asset) => { %>
              <option value="<%= asset.url %>"><%= asset.name %></option>
            <% }) %>
          </select>
        </label>

        <label>
          Ou envie uma nova imagem do card
          <input type="file" name="card_image_file" accept=".png,.jpg,.jpeg,.webp,.gif,.svg" />
        </label>
        <p class="muted small">Se enviar um novo arquivo, ele passa a ser usado no card deste sistema.</p>

        <div class="form-actions-inline admin-modal-actions">
          <button
            type="submit"
            class="btn btn-danger"
            formaction="/admin/systems/0/delete"
            formmethod="post"
            data-system-delete
            hidden
          >
            Excluir Sistema
          </button>
          <button type="button" class="btn btn-ghost" data-system-edit-cancel>Cancelar</button>
          <button type="submit" class="btn btn-primary">Salvar Alteracoes</button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('partials/foot') %>
