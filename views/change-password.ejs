<%- include('partials/head', { title, theme }) %>

<main class="auth-page omega-page">
  <section class="glass-card password-card">
    <div class="password-card-header">
      <h1>Trocar senha</h1>
      <p>Atualize sua senha de acesso ao Ecossistema.</p>
    </div>

    <%- include('partials/flash', { flash }) %>

    <form method="post" action="/account/password" class="form-stack password-form">
      <label>
        Senha atual
        <input type="password" name="current_password" minlength="6" autocomplete="current-password" required />
      </label>

      <label>
        Nova senha
        <input type="password" name="new_password" minlength="6" autocomplete="new-password" required />
      </label>

      <label>
        Confirmar nova senha
        <input type="password" name="confirm_password" minlength="6" autocomplete="new-password" required />
      </label>

      <div class="password-form-actions">
        <a class="btn btn-ghost" href="/dashboard">Voltar</a>
        <button type="submit" class="btn btn-primary">Salvar senha</button>
      </div>
    </form>
  </section>
</main>

<%- include('partials/foot') %>
