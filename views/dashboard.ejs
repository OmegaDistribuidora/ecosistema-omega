<%- include('partials/head', { title, theme }) %>

<main class="dashboard-page omega-page">
  <% if (activeAnnouncements && activeAnnouncements.length) { %>
    <div class="dashboard-notice-overlay" data-dashboard-notice data-announcement-ids="<%= activeAnnouncements.map((notice) => notice.id).join(',') %>">
      <div class="dashboard-notice-dialog glass-card" role="dialog" aria-modal="true" aria-labelledby="dashboard-notice-title">
        <div class="dashboard-notice-layout">
          <div class="dashboard-notice-content">
            <div class="dashboard-notice-header">
              <h2 id="dashboard-notice-title">Comunicado<%= activeAnnouncements.length > 1 ? 's' : '' %> ativo<%= activeAnnouncements.length > 1 ? 's' : '' %></h2>
              <p class="muted small">Leia o aviso antes de continuar no Ecossistema.</p>
            </div>

            <div class="dashboard-notice-list">
              <% activeAnnouncements.forEach((notice) => { %>
                <article class="dashboard-notice-item">
                  <strong><%= notice.title %></strong>
                  <p><%= notice.message %></p>
                </article>
              <% }) %>
            </div>

            <div class="dashboard-notice-actions">
              <button type="button" class="btn btn-primary" data-dashboard-notice-ok>OK</button>
            </div>
          </div>

          <aside class="dashboard-notice-visual" aria-hidden="true">
            <img
              src="/public/assets/notices/comunicado-aurora.png"
              alt=""
              class="dashboard-notice-aurora"
            />
          </aside>
        </div>
      </div>
    </div>
  <% } %>

  <header class="dashboard-top">
    <div class="dashboard-top-left">
      <img
        src="/public/assets/login/logo-branca-omega.png"
        alt="Omega Distribuidora"
        class="dashboard-corner-brand"
        onerror="this.onerror=null;this.src='/public/assets/omega-logo.svg';"
      />
    </div>

    <div class="dashboard-brand-wrap">
      <img
        src="/public/assets/login/logo-ecosistema-omega.png"
        alt="Ecossistema Omega"
        class="dashboard-ecosystem-brand"
      />
    </div>
    <div class="dashboard-actions">
      <% if (currentUser && currentUser.is_admin) { %>
        <a class="btn btn-secondary" href="/admin">Painel Admin</a>
      <% } %>
      <a class="btn btn-ghost" href="/account/password">Trocar senha</a>

      <form method="post" action="/logout">
        <button type="submit" class="btn btn-ghost">Sair</button>
      </form>
    </div>
  </header>

  <section class="selector-card omega-selector">
    <% if (!systems.length) { %>
      <p class="muted">Sem sistemas liberados para seu usuario.</p>
    <% } else { %>
      <div class="dashboard-carousel-stage">
        <div class="welcome-banner">
          <div>
            <strong>Bem-vindo de volta, <%= (currentUser && currentUser.username) || 'usuario' %>.</strong>
            <span>Hoje &eacute; <%= todayLabel %>.</span>
          </div>
        </div>

        <section class="systems-carousel" data-systems-carousel>
          <button type="button" class="carousel-nav prev" data-carousel-prev aria-label="Card anterior">
            <span aria-hidden="true">&#8249;</span>
          </button>

          <div class="carousel-viewport" data-carousel-viewport>
            <div class="carousel-track" data-carousel-track>
              <% systems.forEach((system, index) => { %>
                <article class="carousel-slide" data-carousel-slide data-slide-index="<%= index %>">
                  <a
                    class="system-card"
                    href="/go/<%= system.id %>"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-system-name="<%= system.name %>"
                    data-system-description="<%= system.description || 'Acessar sistema' %>"
                  >
                    <div class="system-card-media">
                      <img
                        src="<%= system.preview_image_url || '/public/assets/omega-logo.svg' %>"
                        alt="<%= system.name %>"
                        loading="lazy"
                        onerror="this.onerror=null;this.src='/public/assets/omega-logo.svg';"
                      />
                    </div>

                    <div class="system-card-body">
                      <h2><%= system.name %></h2>
                    </div>
                  </a>
                </article>
              <% }) %>
            </div>
          </div>

          <button type="button" class="carousel-nav next" data-carousel-next aria-label="Proximo card">
            <span aria-hidden="true">&#8250;</span>
          </button>

          <div class="carousel-dots" data-carousel-dots aria-label="Selecionar sistema"></div>
        </section>

        <div class="carousel-description" data-carousel-description>
          <p class="carousel-description-text" data-carousel-description-text></p>
        </div>
      </div>
    <% } %>
  </section>
</main>

<%- include('partials/foot') %>
