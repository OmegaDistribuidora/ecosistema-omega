<%- include('partials/head', { title, theme }) %>

<main class="dashboard-page omega-page">
  <header class="dashboard-top glass-card omega-header">
    <div class="brand-inline">
      <img
        src="<%= fixedLogoUrl %>"
        alt="Omega Distribuidora"
        class="omega-logo"
        onerror="this.onerror=null;this.src='/public/assets/omega-logo.svg';"
      />
      <div class="brand-text">
        <h1><%= (theme && theme.app_name) || 'Ecossistema Omega' %></h1>
        <p>Central de Sistema da Omega Distribuidora</p>
      </div>
    </div>

    <div class="dashboard-actions">
      <% if (currentUser && currentUser.is_admin) { %>
        <a class="btn btn-secondary" href="/admin">Painel Admin</a>
      <% } %>

      <form method="post" action="/logout">
        <button type="submit" class="btn btn-ghost">Sair</button>
      </form>
    </div>
  </header>

  <section class="selector-card glass-card omega-selector">
    <div class="welcome-banner">
      <div>
        <strong>Bem-vindo de volta, <%= (currentUser && currentUser.username) || 'usuario' %>.</strong>
        <span>Hoje &eacute; <%= todayLabel %>.</span>
      </div>
    </div>

    <% if (!systems.length) { %>
      <p class="muted">Sem sistemas liberados para seu usuario.</p>
    <% } else { %>
      <section class="systems-card-grid">
        <% systems.forEach((system) => { %>
          <% const status = (systemStatuses && systemStatuses[system.id]) || { online: false, statusCode: null }; %>
          <a
            class="system-card"
            href="/go/<%= system.id %>"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="system-card-media">
              <img
                src="<%= system.preview_image_url || '/public/assets/omega-logo.svg' %>"
                alt="<%= system.name %>"
                loading="lazy"
                onerror="this.onerror=null;this.src='/public/assets/omega-logo.svg';"
              />
            </div>

            <div class="system-card-body">
              <h2><%= system.name %></h2>
              <p><%= system.description || 'Acessar sistema' %></p>

              <div class="system-card-footer">
                <span class="card-status-badge <%= status.online ? 'is-online' : 'is-offline' %>">
                  <%= status.online ? 'Online' : 'Offline' %>
                </span>
              </div>
            </div>
          </a>
        <% }) %>
      </section>
    <% } %>
  </section>
</main>

<%- include('partials/foot') %>
