<%- include('partials/head', { title, theme }) %>

<main class="auth-page omega-page login-stage">
  <section class="login-scene">
    <img
      src="/public/assets/login/logo-branca-omega.png"
      alt="Omega Distribuidora"
      class="login-corner-brand"
      onerror="this.onerror=null;this.src='/public/assets/omega-logo.svg';"
    />

    <div class="login-ecosystem-mark">
      <img
        src="/public/assets/login/logo-ecosistema-omega.png"
        alt="Ecossistema Omega"
        class="login-ecosystem-logo"
      />
      <h1 class="sr-only"><%= (theme && theme.app_name) || 'Ecossistema Omega' %></h1>
    </div>

    <img
      src="/public/assets/login/aurora-tablet-ecosistema.png"
      alt=""
      class="login-character-art"
      aria-hidden="true"
    />

    <div class="login-panel-stack">
      <section class="login-access-panel" aria-labelledby="login-title">
        <h2 id="login-title">Acessar</h2>
        <p class="login-lead">Entre com seu usu&aacute;rio e senha.</p>

        <%- include('partials/flash', { flash }) %>

        <form method="post" action="/login" class="form-stack login-form" data-login-form>
          <label>
            Usu&aacute;rio:
            <input type="text" name="username" autocomplete="username" required />
          </label>

          <label>
            Senha:
            <div class="input-with-action login-password-field">
              <input type="password" name="password" autocomplete="current-password" required data-password-input />
              <button type="button" class="toggle-pass-eye" data-toggle-password aria-label="Mostrar senha" aria-pressed="false">
                <span class="sr-only" data-toggle-label>Mostrar senha</span>
                <svg class="eye-icon" data-eye-open viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M1.5 12s3.8-6.5 10.5-6.5S22.5 12 22.5 12s-3.8 6.5-10.5 6.5S1.5 12 1.5 12Z" />
                  <circle cx="12" cy="12" r="3.5" />
                </svg>
                <svg class="eye-icon hidden" data-eye-closed viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M3 4.5 21 19.5" />
                  <path d="M10.6 6.1A9.7 9.7 0 0 1 12 6c6.7 0 10.5 6 10.5 6a18.9 18.9 0 0 1-4 4.5" />
                  <path d="M6.2 8.3A18.3 18.3 0 0 0 1.5 12s3.8 6.5 10.5 6.5c1.8 0 3.4-.4 4.8-1" />
                  <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                </svg>
              </button>
            </div>
          </label>

          <p class="caps-warning hidden" data-caps-warning>Caps Lock parece estar ativo.</p>

          <button type="submit" class="btn btn-primary login-submit-btn" data-login-submit>
            <span data-submit-label>Entrar</span>
            <span class="btn-spinner hidden" data-submit-spinner></span>
          </button>
        </form>
      </section>

      <p class="login-support-copy">Ambiente integrado para acesso r&aacute;pido e seguro aos <br />sistemas da &Ocirc;mega Distribuidora.</p>
    </div>
  </section>
</main>

<%- include('partials/foot') %>
