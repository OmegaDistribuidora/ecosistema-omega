<%- include('partials/head', { title, theme }) %>

<main class="admin-page omega-page">
  <header class="page-header glass-card omega-header">
    <div class="admin-header-left">
      <img src="<%= fixedLogoUrl %>" alt="Omega Distribuidora" class="omega-logo" onerror="this.onerror=null;this.src='/public/assets/omega-logo.svg';" />
      <div>
        <h1>Gerenciar Usuarios</h1>
        <p>Criar e editar usuarios no mesmo painel.</p>
      </div>
    </div>

    <div class="page-actions">
      <details class="admin-nav-dropdown">
        <summary class="btn btn-secondary">Navegacao</summary>
        <div class="admin-nav-menu glass-card">
          <a href="/admin">Menu Admin</a>
          <a href="/admin/users">Usuarios</a>
          <a href="/admin/systems">Sistemas</a>
          <a href="/admin/notices">Comunicados</a>
          <a href="/admin/mappings">Mapeamentos</a>
          <a href="/admin/history">Historico</a>
          <a href="/dashboard">Painel Principal</a>
        </div>
      </details>
    </div>
  </header>

  <%- include('partials/flash', { flash }) %>

  <section class="split-grid admin-management-grid">
    <article class="glass-card admin-section">
      <div class="admin-section-head">
        <div>
          <h2 class="section-title">Usuarios</h2>
          <p class="muted">Cadastre novos usuarios em um popup e mantenha a lista principal mais limpa.</p>
        </div>
        <button type="button" class="btn btn-primary" data-open-modal="user-create-modal">Novo Usuario</button>
      </div>

      <div class="admin-callout">
        <strong>Fluxo simplificado</strong>
        <p class="muted small">Criacao e edicao agora acontecem em modal, com os mesmos campos e validacoes do sistema atual.</p>
      </div>
    </article>

    <article class="glass-card admin-section">
      <h2 class="section-title">Usuarios Cadastrados</h2>
      <p class="muted small">A visao consolidada dos vinculos por sistema fica em <a href="/admin/mappings">Mapeamentos</a>.</p>

      <div class="compact-list">
        <% users.forEach((user) => { %>
          <div class="compact-row">
            <div class="compact-main">
              <strong><%= user.username %></strong>
              <span class="muted small"><%= user.is_admin ? 'Administrador' : 'Usuario' %></span>
              <span class="muted small">Modulos: <%= user.system_names || 'Nenhum' %></span>
            </div>
            <button
              type="button"
              class="icon-edit-btn"
              data-user-edit
              data-user-id="<%= user.id %>"
              data-username="<%= user.username %>"
              data-is-admin="<%= user.is_admin ? '1' : '0' %>"
              data-system-ids="<%= user.system_ids || '' %>"
              data-sso-mappings="<%= encodeURIComponent(JSON.stringify(user.ssoMappings || [])) %>"
              title="Editar usuario"
            >
              &#9998;
            </button>
          </div>
        <% }) %>
      </div>
    </article>
  </section>

  <% const ssoSystems = systems.filter((system) => system.sso_enabled); %>

  <div class="admin-modal hidden" data-modal="user-create-modal" aria-hidden="true">
    <div class="admin-modal-backdrop" data-close-modal></div>
    <div class="admin-modal-dialog glass-card" role="dialog" aria-modal="true" aria-labelledby="user-create-modal-title">
      <div class="admin-modal-header">
        <div>
          <h3 id="user-create-modal-title">Novo Usuario</h3>
          <p class="muted small">Preencha os dados e defina os acessos iniciais.</p>
        </div>
        <button type="button" class="admin-modal-close" aria-label="Fechar popup" data-close-modal>&times;</button>
      </div>

      <form method="post" action="/admin/users" class="form-stack compact admin-modal-form" data-reset-on-open>
        <label>
          Usuario
          <input type="text" name="username" required />
        </label>

        <label>
          Senha inicial
          <input type="password" name="password" minlength="6" required />
        </label>

        <label class="check-row">
          <input type="checkbox" name="is_admin" />
          <span>Administrador</span>
        </label>

        <fieldset>
          <legend>Modulos com acesso</legend>
          <div class="check-grid">
            <% systems.forEach((system) => { %>
              <label class="check-row">
                <input type="checkbox" name="system_ids" value="<%= system.id %>" />
                <span><%= system.name %></span>
              </label>
            <% }) %>
          </div>
        </fieldset>

        <% if (ssoSystems.length) { %>
          <fieldset>
            <legend>Login por sistema (SSO delegado)</legend>
            <div class="form-stack compact">
              <% ssoSystems.forEach((system) => { %>
                <label>
                  <%= system.name %>
                  <input
                    type="text"
                    name="sso_login_<%= system.id %>"
                    placeholder="login usado dentro deste sistema"
                  />
                </label>
              <% }) %>
            </div>
          </fieldset>
        <% } %>

        <div class="form-actions-inline admin-modal-actions">
          <button type="button" class="btn btn-ghost" data-close-modal>Cancelar</button>
          <button type="submit" class="btn btn-primary">Criar Usuario</button>
        </div>
      </form>
    </div>
  </div>

  <div class="admin-modal hidden" data-modal="user-edit-modal" aria-hidden="true">
    <div class="admin-modal-backdrop" data-close-modal></div>
    <div class="admin-modal-dialog glass-card" role="dialog" aria-modal="true" aria-labelledby="user-edit-modal-title">
      <div class="admin-modal-header">
        <div>
          <h3 id="user-edit-modal-title" data-user-edit-title>Editar Usuario</h3>
          <p class="muted small">Atualize acesso, permissao administrativa e logins SSO.</p>
        </div>
        <button type="button" class="admin-modal-close" aria-label="Fechar popup" data-close-modal>&times;</button>
      </div>

      <form method="post" action="/admin/users/0" class="form-stack compact admin-modal-form" data-user-edit-form>
        <input type="text" name="fake_username" autocomplete="username" class="sr-only" tabindex="-1" aria-hidden="true" />
        <input type="password" name="fake_password" autocomplete="current-password" class="sr-only" tabindex="-1" aria-hidden="true" />

        <label>
          Nome de usuario
          <input type="text" name="username" data-user-field="username" required />
        </label>

        <label>
          Nova senha (opcional)
          <input
            type="password"
            name="password"
            minlength="6"
            placeholder="deixe vazio para manter"
            autocomplete="new-password"
            data-user-password-field
          />
        </label>

        <label class="check-row">
          <input type="checkbox" name="is_admin" data-user-field="is_admin" />
          <span>Administrador</span>
        </label>

        <fieldset>
          <legend>Modulos com acesso</legend>
          <div class="check-grid">
            <% systems.forEach((system) => { %>
              <label class="check-row">
                <input type="checkbox" name="system_ids" value="<%= system.id %>" data-user-system-option />
                <span><%= system.name %></span>
              </label>
            <% }) %>
          </div>
        </fieldset>

        <% if (ssoSystems.length) { %>
          <fieldset>
            <legend>Login por sistema (SSO delegado)</legend>
            <div class="form-stack compact">
              <% ssoSystems.forEach((system) => { %>
                <label>
                  <%= system.name %>
                  <input
                    type="text"
                    name="sso_login_<%= system.id %>"
                    data-user-sso-login="<%= system.id %>"
                    placeholder="login usado dentro deste sistema"
                  />
                </label>
              <% }) %>
            </div>
          </fieldset>
        <% } %>

        <div class="form-actions-inline admin-modal-actions">
          <button type="button" class="btn btn-ghost" data-user-edit-cancel>Cancelar</button>
          <button type="submit" class="btn btn-primary">Salvar Alteracoes</button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('partials/foot') %>
